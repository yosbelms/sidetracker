J106_PARAM(Pwm,         Osc,    "PWM",          Percent,  0,       1,     0,      26)
J106_PARAM(Cutoff,      Filter, "Cutoff",       Hertz,    20,      16000, 1800,   74)
J106_PARAM(Resonance,   Filter, "Resonance",    Percent,  0,       1,     0.22,   71)
