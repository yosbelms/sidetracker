J106_PARAM(Pulse,       Osc,    "Pulse",        Switch,   0,       1,     0,      21)
J106_PARAM(Sub,         Osc,    "Sub",          Switch,   0,       1,     1,      22)
J106_PARAM(SubLevel,    Osc,    "Sub Level",    Percent,  0,       1,     0.3,    23)
J106_PARAM(Noise,       Osc,    "Noise",        Percent,  0,       1,     0,      24)
